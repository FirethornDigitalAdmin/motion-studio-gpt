{
  "name": "motion-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx server/index.ts",
    "build": "tsc --noEmit && vite build",
    "render": "tsx server/cli.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "verify": "npm run build && npm test && npm run test:e2e",
    "postinstall": "playwright install chromium",
    "format": "prettier --write src server tests *.ts *.json"
  },
  "dependencies": {
    "archiver": "^7.0.1",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "unzipper": "^0.12.3",
    "zod": "^4.1.5",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@fontsource/roboto": "^5.3.0",
    "@playwright/test": "^1.55.0",
    "@types/archiver": "^6.0.3",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.18.0",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@types/unzipper": "^0.10.11",
    "@vitejs/plugin-react": "^5.0.2",
    "agent-browser": "^0.20.0",
    "ffmpeg-static": "^5.2.0",
    "playwright": "^1.55.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.9.9",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
